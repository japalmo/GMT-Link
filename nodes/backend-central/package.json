{
  "name": "@gmt-platform/backend-central",
  "version": "0.1.0",
  "private": true,
  "description": "GMT Link — API NestJS",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "fga:bootstrap": "tsx scripts/fga-bootstrap.ts",
    "seed:auth-dev": "tsx prisma/seed-auth-dev.ts",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "seed:capstone": "tsx prisma/seed-capstone.ts",
    "seed:mockups": "tsx prisma/seed-mockups.ts",
    "test": "pnpm run typecheck:test && vitest run",
    "test:unit": "pnpm run typecheck:test && vitest run --exclude test/fga-model.spec.ts",
    "test:integration:fga": "vitest run test/fga-model.spec.ts",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@gmt-platform/contracts": "workspace:*",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@openfga/sdk": "^0.9.7",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "geotiff": "^3.0.5",
    "helmet": "^8.3.0",
    "isomorphic-dompurify": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.12",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@openfga/syntax-transformer": "^0.2.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "dotenv": "^16.4.7",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
